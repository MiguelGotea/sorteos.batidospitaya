# ==============================================================================
# .HTACCESS - SORTEOS.BATIDOSPITAYA.COM
# ==============================================================================

RewriteEngine On

DirectoryIndex index.php index.html

# Seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddDefaultCharset UTF-8

# Proteger carpeta core
<IfModule mod_rewrite.c>
    RewriteRule ^core/ - [F,L]
</IfModule>

# Proteger carpeta uploads (solo imágenes, sin ejecución PHP)
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Require all denied
    </If>
</FilesMatch>

# ─── Bloquear archivos sensibles accesibles por URL ──────────────────────────
# README.md, archivos SQL, scripts, logs, configuraciones — no deben ser públicos
<FilesMatch "\.(md|sql|log|sh|ps1|env|gitignore|yml|yaml|json|txt|bak|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso a carpetas de desarrollo y configuración
<IfModule mod_rewrite.c>
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^\.scripts/ - [F,L]
    RewriteRule ^img_bosquejos/ - [F,L]
</IfModule>

